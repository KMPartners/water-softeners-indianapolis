{
  "name": "beach-family-automotive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env PUBLIC_REVIEW_FORM=1 astro dev",
    "build": "astro build",
    "build:cf": "astro build && node scripts/stamp-noindex-if-preview.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "airtable:provision": "node --env-file-if-exists=.env scripts/provision-airtable.mjs",
    "airtable:seed": "node --env-file-if-exists=.env scripts/provision-airtable.mjs --seed",
    "airtable:check": "node --env-file-if-exists=.env scripts/provision-airtable.mjs --check",
    "review:provision": "node --env-file-if-exists=.env scripts/provision-review-form.mjs",
    "review:read": "node --env-file-if-exists=.env scripts/read-review-answers.mjs",
    "ghl:test": "node --env-file-if-exists=.env scripts/ghl-test.mjs",
    "deploy:staging": "cross-env PUBLIC_REVIEW_FORM=1 astro build && node scripts/stamp-staging-noindex.mjs && npx wrangler pages deploy dist --project-name=beach-family-automotive --branch=staging --commit-dirty=true",
    "deploy:prod": "cross-env PUBLIC_REVIEW_FORM=0 astro build && npx wrangler pages deploy dist --project-name=beach-family-automotive --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "astro": "^5.6.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
