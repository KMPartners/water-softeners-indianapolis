---
/**
 * Service / repair appointment request form.
 *
 * Same lead pipeline as PreQualForm (posts to the multi-intent Pages Function at
 * /api/pre-qualify), but with intent="service" so it is tagged web-service in
 * GoHighLevel and can be routed to a repair-specific note + notification. Self
 * contained (own script + styles), mirroring PreQualForm.
 *
 * COMPLIANCE: the repair shop quotes before work begins (copy deck / auto-repair
 * pages). No pricing promises here.
 */
import Icon from './Icon.astro';
import { NAP } from '../lib/site.js';

interface Props {
  heading?: string;
  /** Prefills "What do you need?" when placed on a specific service page. */
  service?: string | null;
}
const { heading = 'Request Service', service = '' } = Astro.props;

const endpoint = import.meta.env.FORM_ENDPOINT || '/api/pre-qualify';
---

<form
  class="svcform"
  method="post"
  action={endpoint}
  novalidate
  data-service
  data-intent="service"
  id="request-service"
>
  <h3 class="svcform-heading">{heading}</h3>
  <p class="svcform-sub">
    Tell us what your vehicle needs and when works for you. We quote every job
    before any work begins.
  </p>

  {/* Honeypot — hidden from humans; the Pages Function drops any bot that fills it. */}
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
  />
  <input type="hidden" name="intent" value="service" />

  <div class="svcform-grid">
    <label class="field">
      <span class="field-label">Full name</span>
      <input type="text" name="name" autocomplete="name" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field">
      <span class="field-label">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field field-wide">
      <span class="field-label">Vehicle (year, make, model)</span>
      <input type="text" name="vehicle" placeholder="e.g. 2014 Chevrolet Malibu" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field">
      <span class="field-label">What do you need?</span>
      <input type="text" name="service" value={service} placeholder="e.g. brakes, oil change, check engine light" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field">
      <span class="field-label">Preferred timing</span>
      <select name="timeframe" required>
        <option value="">Select…</option>
        <option>As soon as possible</option>
        <option>This week</option>
        <option>Just getting a quote</option>
      </select>
      <span class="field-error" data-error></span>
    </label>

    <label class="field field-wide">
      <span class="field-label">Notes (optional)</span>
      <textarea name="message" rows="3" placeholder="Anything else we should know?"></textarea>
      <span class="field-error" data-error></span>
    </label>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>
      I agree to be contacted by {NAP.name} about my request, by
      phone, text, or email.
    </span>
  </label>
  <span class="field-error consent-error" data-error></span>

  <button type="submit" class="btn-primary svcform-submit">
    {heading}
    <Icon name="arrow-right" size={18} />
  </button>

  <p class="svcform-formerror" role="alert" hidden data-service-error>
    Sorry — something went wrong sending your request. Please call or text us at
    <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a> and we will take care of you.
  </p>
</form>

<div class="svcform-success" hidden data-service-success>
  <span class="success-mark"><Icon name="check" size={26} /></span>
  <h3>Thanks — we have got it.</h3>
  <p>
    Someone from {NAP.name} will reach out to schedule. To talk now,
    call us at <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a>.
  </p>
</div>

<script>
  // Client-side validation + success state; native submit still works with JS off.
  const form = document.querySelector('[data-service]');
  const success = document.querySelector('[data-service-success]');
  const errorBox = document.querySelector('[data-service-error]');

  if (form instanceof HTMLFormElement) {
    const setError = (field, message) => {
      const slot = field.closest('.field, .consent')?.parentElement?.querySelector('[data-error]')
        ?? field.closest('.field')?.querySelector('[data-error]');
      if (slot) slot.textContent = message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    const validate = (field) => {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return true;
      if (field.validity.valueMissing) {
        setError(field, field.type === 'checkbox' ? 'Please agree before continuing.' : 'Required.');
        return false;
      }
      if (field.name === 'phone' && field.value.replace(/\D/g, '').length < 10) {
        setError(field, 'Enter a 10-digit phone number.');
        return false;
      }
      setError(field, '');
      return true;
    };

    form.querySelectorAll('input, select').forEach((f) => {
      f.addEventListener('blur', () => validate(f));
      f.addEventListener('input', () => {
        if (f.getAttribute('aria-invalid') === 'true') validate(f);
      });
    });

    form.addEventListener('submit', async (e) => {
      const fields = [...form.querySelectorAll('input, select')];
      const allValid = fields.map(validate).every(Boolean);
      if (!allValid) {
        e.preventDefault();
        form.querySelector('[aria-invalid="true"]')?.focus();
        return;
      }

      e.preventDefault();
      if (errorBox instanceof HTMLElement) errorBox.hidden = true;

      const submit = form.querySelector('button[type="submit"]');
      let submitHTML = '';
      if (submit instanceof HTMLButtonElement) {
        submitHTML = submit.innerHTML;
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      let ok = false;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        ok = res.ok;
      } catch {
        ok = false;
      }

      if (!ok) {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.innerHTML = submitHTML;
        }
        if (errorBox instanceof HTMLElement) {
          errorBox.hidden = false;
          errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      // Same GTM/GA4 signal as the other forms; lead_form comes from data-intent.
      const vehicleVal = form.querySelector('input[name="vehicle"]')?.value || '';
      (window.dataLayer = window.dataLayer || []).push({
        event: 'lead_submit',
        lead_form: form.getAttribute('data-intent') || 'service',
        ...(vehicleVal ? { vehicle: vehicleVal } : {}),
      });

      form.hidden = true;
      if (success instanceof HTMLElement) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }
</script>

<style>
  .svcform {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    padding: clamp(20px, 3vw, 28px);
    box-shadow: var(--shadow-lg);
  }
  .svcform-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--navy-700);
    margin: 0 0 8px;
  }
  .svcform-sub {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 20px;
  }

  .svcform-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .field-wide { grid-column: 1 / -1; }
  @media (max-width: 640px) {
    .svcform-grid { grid-template-columns: 1fr; }
  }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-1);
    padding: 11px 12px;
    width: 100%;
    resize: vertical;
  }
  @media (max-width: 640px) {
    .field input,
    .field select,
    .field textarea { font-size: 16px; }
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible,
  .consent input:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-color: var(--amber-500);
  }
  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'] { border-color: var(--alert); }

  .field-error {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--alert);
    min-height: 1em;
  }
  .field-error:empty { display: none; }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 18px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .consent input {
    margin-top: 3px;
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    accent-color: var(--amber-600);
  }

  .svcform-submit {
    width: 100%;
    justify-content: center;
    margin-top: 18px;
  }
  .svcform-submit:disabled { opacity: 0.7; cursor: default; }

  .svcform-formerror {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--alert);
    margin: 14px 0 0;
  }
  .svcform-formerror[hidden] { display: none; }

  .svcform-success {
    background: var(--surface-card);
    border: 1px solid var(--go);
    border-radius: var(--radius-2);
    padding: clamp(24px, 4vw, 34px);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .svcform-success[hidden] { display: none; }
  .success-mark {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--go-soft);
    color: var(--go);
  }
  .svcform-success h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--navy-700);
    margin: 0 0 8px;
  }
  .svcform-success p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
</style>
