---
/**
 * Mobile chrome, Variant B (vanilla side drawer), LOCKED. Renders three things,
 * all styled by the verbatim mobile-chrome.css (this is markup + data only):
 *   1. `.mobile-bottom-bar`, scroll-reveal action bar (call + quote), shown ≤1024,
 *      revealed past 480px by chrome.js, hidden while the drawer is open (CSS).
 *   2. `.mobile-nav-overlay`, the scrim.
 *   3. `.mobile-nav`, the NON-SCROLLING drawer: fixed lockup → scroll middle →
 *      pinned action bar (§E1 five-section content).
 *
 * Behavior (open/close/Esc/overlay/scroll-lock/focus) is wired once in
 * src/scripts/chrome.js. The drawer never scrolls; §E2 compaction in the CSS
 * keeps it fitting down to 320×568.
 *
 * NEVER-FABRICATE gates applied here (override the locked design copy per
 * guardrail #3): "Licensed & insured" renders only when licensedClaimAllowed is
 * confirmed; the status lines use the config service-area status, not an
 * unverified "Open now / 24/7" availability claim (hours unconfirmed).
 */
import { NAP, CTA_STATUS, LICENSED_CLAIM_ALLOWED } from '../lib/site.js';
import { DRAWER_PRIMARY, DRAWER_QUICK_LINKS, SERVICE_AREAS } from '../content/nav.js';

const licenseLine = [
  'Authorized Generac Dealer',
  LICENSED_CLAIM_ALLOWED ? 'Licensed & insured' : null,
  'Free assessments',
].filter(Boolean).join(' · ');
---

{/* 1 · scroll-reveal bottom action bar */}
<div class="mobile-bottom-bar" aria-hidden="true">
  <div class="mbb-status"><span class="dot"></span><span>{CTA_STATUS}</span></div>
  <div class="mbb-actions">
    <a href={NAP.phoneTel} class="mbb-call">
      <span class="mbb-icon" aria-hidden="true">☏</span>
      <span><span class="mbb-sm">Call</span><span class="mbb-lg">{NAP.phoneDisplay}</span></span>
    </a>
    <a href="#contact" class="mbb-quote">Free Quote <span aria-hidden="true">&rarr;</span></a>
  </div>
</div>

{/* 2 · overlay */}
<div id="mobile-nav-overlay" class="mobile-nav-overlay"></div>

{/* 3 · drawer */}
<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-nav-header">
    <a href="/" class="drawer-brand" aria-label={`${NAP.name}, home`}>
      <span class="logo-mark logo-mark--invert logo-mark--34" aria-hidden="true"></span>
      <span class="drawer-lines">
        <span class="drawer-word">MER<span class="mrd">I</span>DIAN</span>
        <span class="drawer-sub">GENERATOR &amp; ELECTRIC</span>
      </span>
    </a>
    <button class="mobile-nav-close" aria-label="Close menu">✕</button>
  </div>

  <div class="mobile-nav-scroll">
    <p class="byline--micro byline--on-dark drawer-byline">
      <span class="byline-tick" aria-hidden="true"></span>
      <span class="byline-clause">Dealer-grade installs</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-clause byline-value">Owner-direct pricing</span>
    </p>

    <div class="mobile-menu-eyebrow"><span class="dot"></span><span>Authorized Generac Dealer · Fishers, IN</span></div>

    <ul class="mobile-menu-primary">
      {DRAWER_PRIMARY.map((c) => (
        <li><a href={c.href}>
          <span class="mm-num">{c.n}</span>
          <span class="mm-label">{c.label}</span>
          <span class="mm-meta">{c.meta}</span>
        </a></li>
      ))}
    </ul>

    <div class="mobile-menu-section">
      <div class="mm-section-label">Quick links</div>
      <div class="mobile-menu-secondary">
        {DRAWER_QUICK_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>

    <div class="mobile-menu-section">
      <div class="mm-section-label">Service area</div>
      <div class="mobile-menu-areas">
        {SERVICE_AREAS.map((a) => <span class="mm-area">{a}</span>)}
      </div>
    </div>
  </div>

  {/* pinned action bar: call + quote. Never scrolls with the menu. */}
  <div class="mobile-menu-cta">
    <a href={NAP.phoneTel} class="mm-call">
      <span class="mm-call-label">Tap to call</span>
      <span class="mm-call-number">{NAP.phoneDisplay}</span>
    </a>
    <a href="#contact" class="mm-quote">
      <span class="mm-call-label mm-quote-label">Fixed-bid</span>
      <span class="mm-quote-action">Get a quote</span>
    </a>
    <div class="mm-license">{licenseLine}</div>
  </div>
</nav>

<style>
  /* the drawer lockup wordmark, mirrors the header, sized for the drawer.
     .mrd / .logo-mark--invert come from the verbatim logo.css. */
  .drawer-brand { display: flex; align-items: center; gap: 11px; }
  .drawer-lines { line-height: 1; }
  .drawer-word {
    display: block; font-family: var(--font-display); font-weight: 800;
    font-size: 16px; color: var(--on-slab);
  }
  .drawer-sub {
    display: block; font-family: var(--font-mono); font-size: 8px;
    letter-spacing: .22em; color: var(--accent); margin-top: 5px;
  }
</style>
