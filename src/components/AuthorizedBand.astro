---
/**
 * "Factory-authorized, warranty-compliant" trust band (dark --slab). The binary
 * IASD trust lever from the entity research: only an authorized service dealer
 * can perform warranty repairs on a Generac, so this claim is the strongest one
 * a brand-new authorized dealer holds. Shared across the homepage, category, and
 * service templates. Claims ONLY authorized / warranty-compliant, never a
 * Premier/Elite tier we do not hold. Tokens only.
 */
---
<section class="authorized">
  <div class="authorized-grid">
    <div>
      <div class="eyebrow">The trust claim that counts</div>
      <h2 class="authorized-h2">Factory-authorized, so your warranty stays intact.</h2>
      <p class="authorized-p">We are a factory-authorized Generac dealer, and that matters for one concrete reason: only an authorized service dealer can perform warranty repairs on a Generac. Work by an uncertified technician can put your coverage at risk. So whether we install your unit or take over one someone else did, our service keeps you warranty-compliant.</p>
    </div>
    <ul class="authorized-list">
      <li><span class="tick" aria-hidden="true">✓</span>Authorized for sales, installation, and warranty-compliant service</li>
      <li><span class="tick" aria-hidden="true">✓</span>Take-over service for orphaned Generac units, coverage intact</li>
      <li><span class="tick" aria-hidden="true">✓</span>We answer the phone, and we service what we install</li>
    </ul>
  </div>
</section>

<style>
  .authorized { background: var(--slab); color: var(--on-slab); }
  .authorized-grid { max-width: var(--container); margin: 0 auto; padding: clamp(40px,6vw,72px) var(--container-pad); display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(28px,4vw,56px); align-items: center; }
  @media (max-width: 860px) { .authorized-grid { grid-template-columns: 1fr; } }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
  .authorized-h2 { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2); letter-spacing: -.015em; line-height: 1.05; margin: 0 0 16px; max-width: 20ch; }
  .authorized-p { font-size: var(--fs-lede); color: var(--on-slab-muted); line-height: 1.6; margin: 0; max-width: 56ch; }
  .authorized-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .authorized-list li { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; line-height: 1.45; color: var(--on-slab-body); }
  .authorized-list .tick { color: var(--accent); font-weight: 800; flex-shrink: 0; }
</style>
