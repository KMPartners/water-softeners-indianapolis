---
/**
 * Site header — ENGINE chrome. A simple, neutral, responsive header: the wordmark
 * lockup (from brand.wordmark in site.config), the primary nav (src/content/nav.js),
 * and a click-to-call. No client design baked in — reskin via tokens, re-nav via
 * the content file. The nav wraps below the brand on narrow screens (no JS).
 */
import { NAP, WORDMARK } from '../lib/site.js';
import { HEADER_NAV } from '../content/nav.js';

interface Props {
  /** Current path, for active-nav highlighting. */
  current?: string;
}
const { current = '' } = Astro.props;
const isActive = (href: string) => href.startsWith('/') && href !== '/' && current.startsWith(href);
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label={`${NAP.name}, home`}>
      <span class="brand-line1">{WORDMARK.line1}</span>
      {WORDMARK.line2 && <span class="brand-line2">{WORDMARK.line2}</span>}
    </a>

    <nav class="nav" aria-label="Primary">
      {HEADER_NAV.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={NAP.phoneTel} class="nav-phone">{NAP.phoneDisplay}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface-card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 14px 0;
    flex-wrap: wrap;
  }
  .brand { display: flex; flex-direction: column; text-decoration: none; line-height: 1.1; }
  .brand-line1 {
    font-family: var(--font-display); font-weight: 800; font-size: 19px;
    letter-spacing: -0.01em; color: var(--text-strong);
  }
  .brand-line2 {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-muted); margin-top: 4px;
  }
  .nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .nav-link {
    font-family: var(--font-body); font-weight: 600; font-size: 14.5px;
    color: var(--text-body); text-decoration: none;
  }
  .nav-link:hover { color: var(--accent-deep); }
  .nav-link.active { color: var(--accent-deep); }
  .nav-phone {
    font-family: var(--font-display); font-weight: 700; font-size: 14px;
    background: var(--accent); color: var(--accent-ink);
    padding: 10px 16px; border-radius: var(--radius); text-decoration: none;
  }
  .nav-phone:hover { background: var(--accent-deep); }
</style>
