---
/**
 * Global footer — ENGINE chrome. Carries, on every page:
 *   · the wordmark lockup (from brand.wordmark / a derived monogram),
 *   · the full parent link set (Mirror-Linking, Core30 rule 3),
 *   · byte-identical NAP,
 *   · the legal links A2P brand review expects to reach here as well as from the
 *     consent checkbox, plus a plain copyright line.
 * All values are tokens/config-driven — no client design baked in.
 */
import { NAP, WORDMARK, LOGO_MARK, AREA_SERVED, FOOTER_BLURB, FOOTER_LEGAL } from '../lib/site.js';
import { LEGAL_LINKS } from '../lib/legal.js';
import { FOOTER_COLUMNS } from '../content/nav.js';

interface Props {
  /** Optional vertical-specific disclaimer paragraph, above the legal line. */
  disclaimer?: string;
}
const { disclaimer } = Astro.props;
const areas = AREA_SERVED.map((a) => String(a).split(',')[0].trim());
---

<footer class="footer">
  <div class="footer-inner">
    <a href="/" class="footer-brand" aria-label={`${NAP.name}, home`}>
      <span class="footer-mark" aria-hidden="true">{LOGO_MARK}</span>
      <span class="footer-lines">
        <span class="footer-word">{WORDMARK.line1}</span>
        {WORDMARK.line2 && <span class="footer-sub">{WORDMARK.line2}</span>}
      </span>
    </a>

    <p class="footer-blurb">{FOOTER_BLURB}</p>

    <div class="footer-grid">
      {FOOTER_COLUMNS.map((col) => (
        <div class="footer-col">
          <div class="footer-heading">{col.heading}</div>
          <div class="footer-links">
            {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </div>
      ))}

      {areas.length > 0 && (
        <div class="footer-col">
          <div class="footer-heading">Service area</div>
          <div class="footer-areas">{areas.join(' · ')}</div>
        </div>
      )}

      <div class="footer-col">
        <div class="footer-heading">Contact</div>
        <address class="footer-nap">
          <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a><br />
          {NAP.streetAddress}<br />
          {NAP.addressLocality}, {NAP.addressRegion} {NAP.postalCode}
        </address>
      </div>
    </div>

    {disclaimer && <p class="footer-disclaimer">{disclaimer}</p>}

    <div class="footer-legal">
      <p class="footer-legal-links">
        {LEGAL_LINKS.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </p>
      <div class="footer-copy">
        <span>{FOOTER_LEGAL}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--slab);
    color: var(--on-slab);
    padding: clamp(36px, 5vw, 64px) var(--container-pad) 40px;
    border-top: 1px solid var(--slab-rule);
  }
  .footer-inner { max-width: var(--container); margin: 0 auto; }

  .footer-brand { display: flex; align-items: center; gap: 13px; margin-bottom: 16px; text-decoration: none; }
  .footer-mark {
    display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
    font-family: var(--font-display); font-weight: 800; font-size: 14px;
    background: var(--accent); color: var(--accent-ink); border-radius: var(--radius);
  }
  .footer-lines { line-height: 1.1; }
  .footer-word { display: block; font-family: var(--font-display); font-weight: 800; font-size: 18px; color: var(--on-slab); }
  .footer-sub { display: block; font-family: var(--font-mono); font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin-top: 5px; }
  .footer-blurb { margin: 0 0 26px; font-size: 14px; color: var(--on-slab-muted); max-width: 60ch; }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
    gap: 28px;
    border-top: 1px solid var(--slab-rule);
    padding-top: 28px;
  }
  .footer-heading {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--on-slab-faint); margin-bottom: 14px;
  }
  .footer-links { display: flex; flex-direction: column; gap: 8px; }
  .footer-links a { color: var(--on-slab-muted); font-size: 14px; text-decoration: none; }
  .footer-links a:hover { color: var(--accent); }
  .footer-areas, .footer-nap { font-size: 14px; color: var(--on-slab-muted); line-height: 2; font-style: normal; }
  .footer-nap a { color: var(--on-slab-muted); }
  .footer-nap a:hover { color: var(--accent); }

  .footer-disclaimer {
    margin: 26px 0 0; font-size: 12px; line-height: 1.6; color: var(--on-slab-dimmer); max-width: 70ch;
  }

  .footer-legal {
    border-top: 1px solid var(--slab-rule);
    margin-top: 28px; padding-top: 18px;
  }
  .footer-legal-links { margin: 0 0 10px; }
  .footer-legal-links a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; font-size: 13px; }
  .footer-copy {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11px; color: var(--on-slab-faint);
  }
</style>
