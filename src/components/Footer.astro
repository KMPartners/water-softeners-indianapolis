---
/**
 * Global footer — Meridian chrome (dark --slab). Carries, on every page:
 *   · the wordmark lockup (logo-mark--invert) + R1 micro byline,
 *   · the full parent link set (Mirror-Linking, Core30 rule 3),
 *   · byte-identical NAP,
 *   · the legal links A2P brand review expects to reach here as well as from the
 *     consent checkbox, plus the copyright + Generac trademark line.
 * Retires the starter's auto footer. All values are tokens/config-driven.
 */
import { NAP } from '../lib/site.js';
import { LEGAL_LINKS } from '../lib/legal.js';
import { FOOTER_COLUMNS, SERVICE_AREAS } from '../content/nav.js';

interface Props {
  /** Optional vertical-specific disclaimer paragraph, above the legal line. */
  disclaimer?: string;
}
const { disclaimer } = Astro.props;
---

<footer class="footer">
  <div class="footer-inner">
    <a href="/" class="footer-brand" aria-label={`${NAP.name} — home`}>
      <span class="logo-mark logo-mark--invert logo-mark--36" aria-hidden="true"></span>
      <span class="footer-lines">
        <span class="footer-word">MER<span class="mrd">I</span>DIAN</span>
        <span class="footer-sub">GENERATOR &amp; ELECTRIC</span>
      </span>
    </a>

    <p class="byline--micro byline--on-dark footer-byline">
      <span class="byline-tick" aria-hidden="true"></span>
      <span class="byline-clause">Dealer-grade installs</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-clause byline-value">Owner-direct pricing</span>
    </p>

    <div class="footer-grid">
      {FOOTER_COLUMNS.map((col) => (
        <div class="footer-col">
          <div class="footer-heading">{col.heading}</div>
          <div class="footer-links">
            {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </div>
      ))}

      <div class="footer-col">
        <div class="footer-heading">Service area</div>
        <div class="footer-areas">{SERVICE_AREAS.join(' · ')}</div>
      </div>

      <div class="footer-col">
        <div class="footer-heading">Contact</div>
        <address class="footer-nap">
          <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a><br />
          {NAP.streetAddress}<br />
          {NAP.addressLocality}, {NAP.addressRegion} {NAP.postalCode}
        </address>
      </div>
    </div>

    {disclaimer && <p class="footer-disclaimer">{disclaimer}</p>}

    <div class="footer-legal">
      <p class="footer-legal-links">
        {LEGAL_LINKS.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </p>
      <div class="footer-copy">
        <span>© 2026 {NAP.name} · Authorized Generac Dealer</span>
        <span class="footer-tm">Generac is a trademark of its owner</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--slab);
    color: var(--on-slab);
    padding: clamp(36px, 5vw, 64px) var(--container-pad) 40px;
    border-top: 1px solid var(--slab-rule);
  }
  .footer-inner { max-width: 1140px; margin: 0 auto; }

  .footer-brand { display: flex; align-items: center; gap: 13px; margin-bottom: 20px; }
  .footer-lines { line-height: 1; }
  .footer-word { display: block; font-family: var(--font-display); font-weight: 800; font-size: 18px; color: var(--on-slab); }
  .footer-sub { display: block; font-family: var(--font-mono); font-size: 9px; letter-spacing: .22em; color: var(--accent); margin-top: 5px; }
  .footer-byline { margin: 0 0 26px; }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 28px;
    border-top: 1px solid var(--slab-rule);
    padding-top: 28px;
  }
  .footer-heading {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--on-slab-faint); margin-bottom: 14px;
  }
  .footer-links { display: flex; flex-direction: column; gap: 8px; }
  .footer-links a { color: var(--on-slab-muted); font-size: 14px; }
  .footer-links a:hover { color: var(--accent); }
  .footer-areas, .footer-nap { font-size: 14px; color: var(--on-slab-muted); line-height: 2; font-style: normal; }
  .footer-nap a { color: var(--on-slab-muted); }
  .footer-nap a:hover { color: var(--accent); }

  .footer-disclaimer {
    margin: 26px 0 0; font-size: 12px; line-height: 1.6; color: var(--on-slab-dimmer); max-width: 70ch;
  }

  .footer-legal {
    border-top: 1px solid var(--slab-rule);
    margin-top: 28px; padding-top: 18px;
  }
  .footer-legal-links { margin: 0 0 10px; }
  .footer-legal-links a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; font-size: 13px; }
  .footer-copy {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11px; color: var(--on-slab-faint);
  }
  .footer-tm { color: var(--on-slab-faintest); }
</style>
