---
/**
 * Global footer. Carries the full parent link set on every page, which is half
 * of mirror linking (Core30 rule 3) — children link UP from here as well as
 * from the breadcrumb.
 */
import { FOOTER_COLUMNS } from '../lib/nav.js';
import { NAP, HOURS_DISPLAY, WORDMARK, LOGO_MARK, FOOTER_BLURB, FOOTER_LEGAL } from '../lib/site.js';

interface Props {
  /** Optional extra legal/disclaimer paragraph rendered above the base legal
      line. Passed by a page (or from config) that needs a vertical-specific
      disclaimer — the engine footer carries none of its own. */
  disclaimer?: string;
}
const { disclaimer } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand-lockup" href="/">
          <span class="logo-mark">{LOGO_MARK}</span>
          <span>
            <span class="wm-1">{WORDMARK.line1}</span><br />
            <span class="wm-2">{WORDMARK.line2}</span>
          </span>
        </a>
        <p class="nap" style="margin-top:16px;max-width:260px">{FOOTER_BLURB}</p>
      </div>

      {FOOTER_COLUMNS.map((col) => (
        <div>
          <h4>{col.heading}</h4>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      ))}

      <div>
        <h4>Visit</h4>
        <p class="nap num">
          {NAP.streetAddress}<br />
          {NAP.addressLocality}, {NAP.addressRegion} {NAP.postalCode}<br />
          {NAP.phoneDisplay}<br />
          <span style="color:var(--navy-400)">{HOURS_DISPLAY}</span>
        </p>
      </div>
    </div>

    {disclaimer && <p class="legal legal-disclaimer">{disclaimer}</p>}

    <div class="legal">{FOOTER_LEGAL}</div>
  </div>
</footer>

<style>
  .legal-disclaimer {
    border-top: 1px solid var(--navy-600);
    margin: 0;
  }
  /* The two legal blocks stack; only the upper one needs the rule. */
  .legal-disclaimer + .legal {
    border-top: none;
    padding-top: 0;
  }
</style>
