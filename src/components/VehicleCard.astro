---
/**
 * Inventory card. Markup ported verbatim from the reference used-cars.html so
 * the .inv-* rules in page-styles.css apply unchanged; only the values are
 * swapped for live Airtable data.
 */
import Icon from './Icon.astro';
import { formatPrice, formatMiles } from '../lib/inventory.js';
import { NAP } from '../lib/site.js';

interface Props {
  vehicle: any;
}
const { vehicle: v } = Astro.props;

const statusClass = (v.status || 'Available').toLowerCase();
const isRebuilt = v.titleStatus === 'Rebuilt';
const titleLabel = v.titleStatus ? `${v.titleStatus} title` : null;
---

<a class="inv-card" href={`/used-cars/${v.slug}/`}>
  <div class="inv-photo">
    {v.heroPhoto ? (
      <img src={v.heroPhoto} alt={`${v.title} for sale in ${NAP.addressLocality}, ${NAP.addressRegion}`} loading="lazy" />
    ) : (
      <>
        <svg class="inv-watermark" viewBox="0 0 24 24"><use href="#i-car" /></svg>
        {/* Photo drop-zone — owner supplies real inventory photos from Airtable. */}
        <span class="inv-drop">Real vehicle photo</span>
      </>
    )}
    <span class={`inv-status ${statusClass}`}>{v.status}</span>
    {v.body && <span class="inv-bodytag">{v.body}</span>}
    <span class="inv-ribbon">
      <Icon name="shield-check" size={13} />
      Shop-inspected
    </span>
  </div>

  <div class="inv-info">
    <div class="inv-yr">{[v.year, v.trim].filter(Boolean).join(' · ')}</div>
    <div class="inv-nm">{[v.make, v.model].filter(Boolean).join(' ')}</div>

    <div class="inv-meta">
      {v.mileage != null && (
        <span class="num">
          <Icon name="gauge" size={13} />
          {formatMiles(v.mileage)}
        </span>
      )}
      {v.drivetrain && <span>{v.drivetrain}</span>}
      {titleLabel && <span class={isRebuilt ? 'rebuilt' : ''}>{titleLabel}</span>}
    </div>

    <div class="inv-price-row">
      <div>
        <div class="inv-plabel">Our price</div>
        <div class="inv-price num">{formatPrice(v.price)}</div>
      </div>
      {/*
        The weekly pill renders ONLY when a real confirmed figure exists in
        Airtable. It is never computed from price — a derived payment implies a
        term and an APR we have not confirmed. See WeeklyPayment in
        src/lib/airtable-schema.mjs.
      */}
      {v.weekly != null && (
        <span class="inv-wk">
          <span class="amt num">${v.weekly}/wk</span>
          <span class="lbl">Est. in-house</span>
        </span>
      )}
    </div>

    <div class="inv-more">
      <span>View details</span>
      <Icon name="arrow-right" size={14} />
    </div>
  </div>
</a>

<style>
  /* Real photos fill the 16:10 drop-zone the gradient otherwise occupies. */
  .inv-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
