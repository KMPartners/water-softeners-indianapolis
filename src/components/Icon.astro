---
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className = '' } = Astro.props;
---

<svg
  class={`ico ${className}`.trim()}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 24 24"
  aria-hidden="true"
><use href={`#i-${name}`} /></svg>
