---
/**
 * Vehicle inquiry form — "ask about this car" on a vehicle detail page.
 *
 * Lightest of the lead forms: name, phone, optional message. Carries the vehicle
 * so a car-page lead is captured WITH its context (fixing the old gap where the
 * only tracked option was an untracked SMS deep link). Posts to the multi-intent
 * Pages Function with intent="vehicle-inquiry" (tagged web-vehicle-inquiry in GHL).
 * Self-contained, mirroring PreQualForm / ServiceForm.
 */
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  /** The vehicle this inquiry is about (name + VIN suffix). */
  vehicle: string;
}
const { heading = 'Ask about this vehicle', vehicle } = Astro.props;

const endpoint = import.meta.env.FORM_ENDPOINT || '/api/pre-qualify';
---

<form
  class="inqform"
  method="post"
  action={endpoint}
  novalidate
  data-inquiry
  data-intent="vehicle-inquiry"
  id="ask"
>
  <h3 class="inqform-heading">{heading}</h3>
  <p class="inqform-sub">
    Questions, availability, or want to set up a time to see it? Send us a note
    and we will get right back to you.
  </p>

  {/* Honeypot */}
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
  />
  <input type="hidden" name="intent" value="vehicle-inquiry" />
  <input type="hidden" name="vehicle" value={vehicle} />

  <div class="inqform-grid">
    <label class="field">
      <span class="field-label">Full name</span>
      <input type="text" name="name" autocomplete="name" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field">
      <span class="field-label">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
      <span class="field-error" data-error></span>
    </label>

    <label class="field field-wide">
      <span class="field-label">Message (optional)</span>
      <textarea name="message" rows="3" placeholder={`I'm interested in the ${vehicle} —`}></textarea>
      <span class="field-error" data-error></span>
    </label>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span>
      I agree to be contacted by Beach Family Automotive about this vehicle, by
      phone, text, or email.
    </span>
  </label>
  <span class="field-error consent-error" data-error></span>

  <button type="submit" class="btn-primary inqform-submit">
    Send inquiry
    <Icon name="arrow-right" size={18} />
  </button>

  <p class="inqform-formerror" role="alert" hidden data-inquiry-error>
    Sorry — something went wrong sending your message. Please call or text us at
    <a href="tel:+17652741878">(765) 274-1878</a>.
  </p>
</form>

<div class="inqform-success" hidden data-inquiry-success>
  <span class="success-mark"><Icon name="check" size={26} /></span>
  <h3>Thanks — we have got it.</h3>
  <p>
    We will reach out about this vehicle shortly. To talk now, call or text
    <a href="tel:+17652741878">(765) 274-1878</a>.
  </p>
</div>

<script>
  const form = document.querySelector('[data-inquiry]');
  const success = document.querySelector('[data-inquiry-success]');
  const errorBox = document.querySelector('[data-inquiry-error]');

  if (form instanceof HTMLFormElement) {
    const setError = (field, message) => {
      const slot = field.closest('.field, .consent')?.parentElement?.querySelector('[data-error]')
        ?? field.closest('.field')?.querySelector('[data-error]');
      if (slot) slot.textContent = message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };
    const validate = (field) => {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return true;
      if (field.validity.valueMissing) {
        setError(field, field.type === 'checkbox' ? 'Please agree before continuing.' : 'Required.');
        return false;
      }
      if (field.name === 'phone' && field.value.replace(/\D/g, '').length < 10) {
        setError(field, 'Enter a 10-digit phone number.');
        return false;
      }
      setError(field, '');
      return true;
    };

    form.querySelectorAll('input, select').forEach((f) => {
      f.addEventListener('blur', () => validate(f));
      f.addEventListener('input', () => {
        if (f.getAttribute('aria-invalid') === 'true') validate(f);
      });
    });

    form.addEventListener('submit', async (e) => {
      const fields = [...form.querySelectorAll('input, select')];
      const allValid = fields.map(validate).every(Boolean);
      if (!allValid) {
        e.preventDefault();
        form.querySelector('[aria-invalid="true"]')?.focus();
        return;
      }
      e.preventDefault();
      if (errorBox instanceof HTMLElement) errorBox.hidden = true;

      const submit = form.querySelector('button[type="submit"]');
      let submitHTML = '';
      if (submit instanceof HTMLButtonElement) {
        submitHTML = submit.innerHTML;
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      let ok = false;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        ok = res.ok;
      } catch {
        ok = false;
      }

      if (!ok) {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.innerHTML = submitHTML;
        }
        if (errorBox instanceof HTMLElement) {
          errorBox.hidden = false;
          errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      const vehicleVal = form.querySelector('input[name="vehicle"]')?.value || '';
      (window.dataLayer = window.dataLayer || []).push({
        event: 'lead_submit',
        lead_form: form.getAttribute('data-intent') || 'vehicle-inquiry',
        ...(vehicleVal ? { vehicle: vehicleVal } : {}),
      });

      form.hidden = true;
      if (success instanceof HTMLElement) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }
</script>

<style>
  .inqform {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    padding: clamp(20px, 3vw, 28px);
    box-shadow: var(--shadow-lg);
  }
  .inqform-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--navy-700);
    margin: 0 0 8px;
  }
  .inqform-sub {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .inqform-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field-wide { grid-column: 1 / -1; }
  @media (max-width: 640px) { .inqform-grid { grid-template-columns: 1fr; } }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-1);
    padding: 11px 12px;
    width: 100%;
    resize: vertical;
  }
  @media (max-width: 640px) {
    .field input,
    .field textarea { font-size: 16px; }
  }
  .field input:focus-visible,
  .field textarea:focus-visible,
  .consent input:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-color: var(--amber-500);
  }
  .field input[aria-invalid='true'] { border-color: var(--alert); }

  .field-error {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--alert);
    min-height: 1em;
  }
  .field-error:empty { display: none; }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 18px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .consent input {
    margin-top: 3px;
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    accent-color: var(--amber-600);
  }

  .inqform-submit { width: 100%; justify-content: center; margin-top: 18px; }
  .inqform-submit:disabled { opacity: 0.7; cursor: default; }

  .inqform-formerror {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--alert);
    margin: 14px 0 0;
  }
  .inqform-formerror[hidden] { display: none; }

  .inqform-success {
    background: var(--surface-card);
    border: 1px solid var(--go);
    border-radius: var(--radius-2);
    padding: clamp(24px, 4vw, 34px);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .inqform-success[hidden] { display: none; }
  .success-mark {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--go-soft);
    color: var(--go);
  }
  .inqform-success h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--navy-700);
    margin: 0 0 8px;
  }
  .inqform-success p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
</style>
