---
/**
 * The transparency / work-order block.
 *
 * REBUILT, not ported. The React kit calls <TransparencyBlock vin titleStatus
 * owners note /> but its implementation lived in _ds_bundle.js, which was not
 * shipped with the design bundle. Props come from the call site
 * (_design-reference/ui_kits_website_react/inventory.jsx:113); the visual
 * language is assembled from existing tokens + the .spec-table / .honest
 * patterns so it sits inside the system rather than beside it.
 *
 * Reviewer: this is one of two components with no pixel reference. Worth a look.
 *
 * Core30 rule 6 lives here — the NHTSA VIN recall lookup is this page's one
 * external authority link.
 */
import Icon from './Icon.astro';

interface Props {
  vin?: string | null;
  titleStatus?: string | null;
  owners?: string | null;
  accidents?: string | null;
  note?: string | null;
}
const { vin, titleStatus, owners, accidents, note } = Astro.props;

const isRebuilt = titleStatus === 'Rebuilt' || titleStatus === 'Salvage';

// Honest default copy, varying with title status. Never claims a clean history
// we cannot evidence — CLAUDE.md requires disclosing material vehicle facts.
const defaultNote = isRebuilt
  ? `${titleStatus} title — prior damage, repaired and re-inspected by the state. Priced accordingly, and we will walk you through exactly what was done.`
  : 'Come see it in person and we will show you everything we know about this vehicle.';

const rows = [
  vin && { k: 'VIN', v: vin, mono: true },
  titleStatus && { k: 'Title status', v: `${titleStatus} title`, flag: isRebuilt },
  owners && { k: 'Previous owners', v: owners },
  accidents && { k: 'Accident history', v: accidents },
  { k: 'Pre-sale inspection', v: 'Inspected on our own lifts before listing' },
].filter(Boolean) as { k: string; v: string; mono?: boolean; flag?: boolean }[];
---

<div class="transparency">
  <div class="transparency-head">
    <Icon name="file-text" size={20} />
    <span>What we know about this vehicle</span>
  </div>

  <div class="spec-table">
    {rows.map((r) => (
      <div class="row">
        <span class="k">{r.k}</span>
        <span class={`v ${r.mono ? 'mono num' : ''}`.trim()}>
          {r.flag ? <strong>{r.v}</strong> : r.v}
        </span>
      </div>
    ))}
  </div>

  <p class="transparency-note">{note || defaultNote}</p>

  {vin && (
    <p>
      {/* Core30 rule 6 — the external authority link for a vehicle page. */}
      <a
        class="backlink"
        href={`https://www.nhtsa.gov/recalls?vin=${encodeURIComponent(vin)}`}
        target="_blank"
        rel="noopener"
      >
        Check this VIN for open recalls at NHTSA ↗
      </a>
    </p>
  )}
</div>

<style>
  .transparency-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .transparency-head :global(.ico) {
    color: var(--accent-deep);
  }

  .transparency-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    max-width: 68ch;
    margin: 16px 0;
  }
</style>
