---
/**
 * "Why homeowners choose Meridian" — the 4-card positioning wedge that repeats
 * on the homepage, category, and service templates (locked design copy). Static
 * content; tokens only. Extracted so the copy lives once, not three times.
 */
const CARDS = [
  { n: '01', h: 'Fixed-bid, in writing', p: 'No "call for pricing." You get a transparent quote after an on-site load calc, and it doesn’t move on you mid-job.' },
  { n: '02', h: 'We answer, and we service', p: 'You reach a person, not a call center, and we maintain what we install. No being handed off or chasing a vanished installer.' },
  { n: '03', h: 'Authorized & warranty-compliant', p: 'As a factory-authorized dealer our work keeps your coverage intact. Only an authorized service dealer can perform warranty repairs.' },
  { n: '04', h: 'Sized by load, not by upsell', p: 'An NEC 220 load calculation sizes the unit to your home, so you buy the generator you actually need, nothing more.' },
];
---

<section class="why">
  <div class="wrap">
    <div class="why-head">
      <h2>Why homeowners choose Meridian</h2>
      <div class="rule" aria-hidden="true"></div>
    </div>
    <div class="why-grid">
      {CARDS.map((c) => (
        <div class="why-card">
          <div class="why-n">{c.n}</div>
          <div class="why-h">{c.h}</div>
          <div class="why-p">{c.p}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why { padding: clamp(40px, 6vw, 64px) var(--container-pad) clamp(8px, 2vw, 16px); }
  .wrap { max-width: var(--container); margin: 0 auto; }
  .why-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 28px; }
  .why-head h2 { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2); letter-spacing: -.015em; margin: 0; color: var(--text-strong); }
  .why-head .rule { flex: 1; height: 1px; background: var(--rule); }
  .why-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px; background: var(--rule); border: 1px solid var(--rule);
    border-radius: var(--radius); overflow: hidden;
  }
  .why-card { background: var(--surface-card); padding: 30px 26px; border-top: 3px solid var(--accent); }
  .why-n { font-family: var(--font-mono); font-size: 12px; color: var(--accent-deep); font-weight: 600; margin-bottom: 14px; }
  .why-h { font-family: var(--font-display); font-weight: 800; font-size: 18px; letter-spacing: -.01em; margin-bottom: 9px; color: var(--text-strong); }
  .why-p { font-size: 14px; color: var(--text-body); line-height: 1.55; }
</style>
