---
/**
 * EntityPage — the generic content-tree template (charter §7), ENGINE.
 *
 * Renders one page from one data ROW. Every content page type — a service, a
 * financing/category page, a city×service page — is an ordered list of typed
 * blocks over the same Core30 spine, so one template serves them all and "new
 * page" is "new row". Modeled on the proven auto-repair/[service] spine, made
 * generic and vertical-agnostic.
 *
 * The caller (a page route) supplies the schema[] and breadcrumbs, since those
 * are preset-specific; EntityPage owns the visible spine. All copy is
 * interpolated ({{business.phoneDisplay}} …) and all gated items resolved before
 * render, so an unconfirmed claim never appears.
 *
 * Row shape:
 *   { trinity, description, canonical, eyebrow,
 *     hero: { h1:{text,accent?}, lede:{strong,rest}, cta:{label,href},
 *             card?: { title, rows:[[k,v],…] } },
 *     blocks: [ …see the block types below… ],
 *     finalCta: { heading, body } }
 *
 * Block types (each carries an optional `label` for the side-index):
 *   { type:'prose',   h2, body|paras[] }
 *   { type:'steps',   h2, items:[{title,body}] }
 *   { type:'list',    h2, items:[ string | {requires,fallback} ] }
 *   { type:'figure',  h2, prefix, value, unit, qualifier }   // qualifier required
 *   { type:'faq',     items:[{q,a}] }                        // every <details open>
 *   { type:'external',h2, blurb, authority:{href,label} }    // exactly one link
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FinalCta from './FinalCta.astro';
import LeadForm from './LeadForm.astro';
import RelatedGuides from './RelatedGuides.astro';
import { NAP } from '../lib/site.js';
import { interpolate, interpolateDeep, resolveItems } from '../lib/content-tree.js';

interface Props {
  page: any;
  crumbs?: { label: string; href?: string }[];
  schemas?: unknown[];
  /** Row-local interpolation values, e.g. { city: 'Springfield' }. */
  ctx?: Record<string, string>;
  /** Reverse hub-and-spoke links: the EXPERIMENTAL supporting spokes that declare
      they support THIS money page (docs/internal-linking-authority.md). Passed by
      the route from getGuidesFor(url); always [] while the flag is off, so the
      RelatedGuides block renders nothing and this page is byte-identical then. */
  guides?: { href: string; label: string; blurb?: string }[];
}
const { page, crumbs = [], schemas = [], ctx = {}, guides = [] } = Astro.props;

const t = (s: unknown) => interpolate(s as string, ctx);
const hero = interpolateDeep(page.hero, ctx);
const finalCta = interpolateDeep(page.finalCta, ctx);

// Numbering is derived from position, so inserting a block never means
// renumbering markup by hand (a real hazard in the hand-authored pages).
const blocks = (page.blocks || []).map((b: any, i: number) => ({ ...b, n: String(i + 1).padStart(2, '0') }));
---

<BaseLayout title={t(page.trinity)} description={t(page.description)} canonical={page.canonical} schemas={schemas}>
  {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}

  <section class="page-hero">
    <div class="plate"></div>
    <div class="container page-hero-grid">
      <div>
        {page.eyebrow && <span class="eyebrow on-dark">{t(page.eyebrow)}</span>}
        {/* Core30 rule 1: this H1 lead is byte-identical to the <title> keyphrase. */}
        <h1>{hero.h1.text}{hero.h1.accent && <> <span class="accent">{hero.h1.accent}</span></>}</h1>
        {/* Core30 rule 2: goal-completion in sentence one. */}
        <p class="lede"><strong>{hero.lede.strong}</strong> {hero.lede.rest}</p>
        <div class="page-hero-cta">
          <a href={NAP.phoneTel} class="click-to-call">
            <Icon name="phone" size={16} />
            {NAP.phoneDisplay}
          </a>
          {hero.cta && (
            <a href={hero.cta.href} class="btn-primary">
              {hero.cta.label}
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </div>
      </div>

      {hero.card && (
        <div class="page-hero-card">
          <div class="ph-title">{hero.card.title}</div>
          {hero.card.rows.map(([k, v]: [string, string]) => (
            <div class="ph-row"><span class="k">{k}</span><span class="v">{v}</span></div>
          ))}
        </div>
      )}
    </div>
  </section>

  {blocks.map((b: any, i: number) => (
    <section class={`content-block${i % 2 === 1 ? ' alt' : ''}`} id={b.anchor}>
      <div class="container">
        <div class="content-grid">
          <div class="side-label"><div class="n">{b.n}</div><div class="t">{t(b.label)}</div></div>
          <div class="block-body" style="width:100%">
            {b.h2 && <h2>{t(b.h2)}</h2>}

            {b.type === 'prose' && (
              (b.paras || [b.body]).map((p: string) => <p>{t(p)}</p>)
            )}

            {b.type === 'steps' && (
              <div class="steps">
                {b.items.map((s: any, j: number) => (
                  <div class="step">
                    <div class="step-num">{String(j + 1).padStart(2, '0')}</div>
                    <div class="step-title">{t(s.title)}</div>
                    <div class="step-body">{t(s.body)}</div>
                  </div>
                ))}
              </div>
            )}

            {b.type === 'list' && (
              <ul class="reassurances">
                {resolveItems(b.items, ctx).map((it: string) => <li><Icon name="check" size={16} />{it}</li>)}
              </ul>
            )}

            {b.type === 'figure' && (
              <p class="figure">
                {t(b.prefix)} <strong class="num">{b.value}</strong>{b.unit}
                {/* qualifier is mandatory and must sit WITH the number — the
                    hand-authored page carried a comment saying so; here it is
                    structural (core30-lint can assert figure.qualifier != ''). */}
                <span class="figure-qualifier"> {t(b.qualifier)}</span>
              </p>
            )}

            {b.type === 'faq' && (
              <div class="faq-list">
                {b.items.map((f: any) => (
                  <details class="faq-item" open>
                    <summary>{t(f.q)}</summary>
                    <p>{t(f.a)}</p>
                  </details>
                ))}
              </div>
            )}

            {b.type === 'external' && (
              <>
                {b.blurb && <p>{t(b.blurb)}</p>}
                <p>
                  <a class="backlink" href={b.authority.href} target="_blank" rel="noopener">
                    {b.authority.label}
                  </a>
                </p>
              </>
            )}

            {/* Internal link list — a parent (hub) links DOWN to its children
                (Core30 rule 3, mirror-linking). Each item: { href, label, note? }. */}
            {b.type === 'links' && (
              <ul class="link-list">
                {b.items.map((it: any) => (
                  <li>
                    <a href={it.href}>{t(it.label)}<Icon name="arrow-right" size={15} /></a>
                    {it.note && <span class="link-note">{t(it.note)}</span>}
                  </li>
                ))}
              </ul>
            )}

            {/* A lead form embedded as a content-tree block. `b.form` is a
                LeadForm config (see the preset lead-forms files). Its anchorId
                is what a hero/CTA hash link targets to open and focus it. */}
            {b.type === 'form' && <LeadForm {...b.form} />}
          </div>
        </div>
      </div>
    </section>
  ))}

  {/* Reverse hub→spoke links (SC-7 reciprocity). Guarded as an expression (like
      finalCta below) so that when there are no guides NO element node is emitted,
      leaving a flag-off money page's HTML byte-identical to pre-port. */}
  {guides.length > 0 && <RelatedGuides guides={guides} />}
  {finalCta && <FinalCta heading={finalCta.heading} body={finalCta.body} />}
</BaseLayout>

<style>
  /* The content-tree spine, scoped to EntityPage so the generic renderer is
     self-contained (a client design layer can still override via tokens). All
     grids use minmax(min(Npx,100%),1fr) so nothing overflows a 320px viewport. */
  .page-hero { position: relative; padding: clamp(32px, 6vw, 64px) 0; border-bottom: 1px solid var(--border); }
  .page-hero .plate { display: none; }
  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(min(460px, 100%), 1fr) minmax(min(280px, 100%), 0.7fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  @media (max-width: 860px) { .page-hero-grid { grid-template-columns: 1fr; } }

  .eyebrow {
    display: inline-block; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-deep); margin-bottom: 12px;
  }
  .page-hero h1 {
    font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h1);
    line-height: var(--lh-head); letter-spacing: var(--ls-tight); color: var(--text-strong); margin: 0 0 14px;
  }
  .page-hero h1 .accent { color: var(--accent-deep); }
  .page-hero .lede { font-size: var(--fs-lede); line-height: var(--lh-body); color: var(--text-body); margin: 0 0 22px; max-width: 52ch; }
  .page-hero .lede strong { color: var(--ink); }
  .page-hero-cta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .click-to-call {
    display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display);
    font-weight: 700; font-size: 16px; color: var(--text-strong); text-decoration: none; min-height: 44px;
  }
  .click-to-call:hover { color: var(--accent-deep); }

  .page-hero-card { background: var(--surface-alt); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 22px; }
  .ph-title { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
  .ph-row { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-top: 1px solid var(--border); font-size: 14px; }
  .ph-row .k { color: var(--text-muted); }
  .ph-row .v { color: var(--text-strong); font-weight: 600; text-align: right; }

  .content-block { padding: clamp(28px, 4.5vw, 52px) 0; }
  .content-block.alt { background: var(--surface-alt); }
  .content-grid {
    display: grid;
    grid-template-columns: minmax(min(120px, 100%), 0.2fr) minmax(min(300px, 100%), 1fr);
    gap: clamp(16px, 3vw, 40px);
    align-items: start;
  }
  @media (max-width: 760px) { .content-grid { grid-template-columns: 1fr; } }
  .side-label { font-family: var(--font-mono); }
  .side-label .n { font-size: 13px; color: var(--accent-deep); font-weight: 700; }
  .side-label .t { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: 4px; }
  .block-body h2 { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2); letter-spacing: var(--ls-tight); color: var(--text-strong); margin: 0 0 16px; }
  .block-body p { font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text-body); margin: 0 0 14px; max-width: 68ch; }

  .steps { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); }
  .step { border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; background: var(--surface-card); }
  .step-num { font-family: var(--font-mono); font-size: 12px; color: var(--accent-deep); font-weight: 700; }
  .step-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-strong); margin: 6px 0; }
  .step-body { font-size: 14px; line-height: 1.55; color: var(--text-body); }

  .reassurances { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .reassurances li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--text-body); }
  .reassurances :global(.ico) { color: var(--success); flex-shrink: 0; margin-top: 3px; }

  .figure { font-size: var(--fs-lede); color: var(--text-body); }
  .figure .num { font-family: var(--font-display); font-weight: 800; color: var(--text-strong); }
  .figure-qualifier { color: var(--text-muted); }

  .link-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .link-list li { display: flex; flex-direction: column; gap: 4px; border: 1px solid var(--border-strong); border-radius: var(--radius); padding: 14px 16px; background: var(--surface-card); }
  .link-list a { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 700; color: var(--text-strong); text-decoration: none; }
  .link-list a:hover { color: var(--accent-deep); }
  .link-note { font-size: 13.5px; color: var(--text-muted); }

  .faq-list { display: grid; gap: 12px; }
  .faq-item { border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; background: var(--surface-card); }
  .faq-item summary { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-strong); cursor: pointer; }
  .faq-item p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--text-body); }

  .backlink { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
</style>
