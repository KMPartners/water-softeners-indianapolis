---
/**
 * Contact + quote section (#contact), the dark band that closes every template
 * (homepage, category, service). Left column = pitch + call; right column = the
 * engine <LeadForm> configured from presets/generator/lead-forms.js.
 *
 * PHASE 5: the placeholder inline form was replaced with <LeadForm>, so the form
 * now carries the TCPA/A2P consent block + SMS opt-in and the lead-capture.js
 * wiring (consent defense package, attribution, name-split, spam signal), and
 * posts to /api/lead. The engine builds the injection-guarded lead summary.
 *
 * NEVER-FABRICATE: the "prefer to call" subline uses a neutral, true line rather
 * than the archetype's unverified "Mon–Fri · 24/7 storm response" (POST-BETA #11).
 */
import { NAP } from '../lib/site.js';
import LeadForm from './LeadForm.astro';
import { QUOTE_FORM } from '../../presets/generator/lead-forms.js';

interface Props {
  heading?: string;
  lede?: string;
}
const {
  heading = 'Tell us about your home.',
  lede = "Send the basics and we'll set up a free on-site assessment, run the load calc, and come back with a transparent, fixed bid, no obligation.",
} = Astro.props;
---

<section id="contact" class="contact">
  <div class="contact-grid">
    <div class="contact-copy">
      <div class="eyebrow">Get your fixed-bid quote</div>
      <h2>{heading}</h2>
      <p class="lede">{lede}</p>
      <ul class="checks">
        <li><span class="tick" aria-hidden="true">✓</span> Free on-site assessment, no obligation</li>
        <li><span class="tick" aria-hidden="true">✓</span> A real person responds, usually same day</li>
        <li><span class="tick" aria-hidden="true">✓</span> Authorized Generac dealer · warranty-compliant</li>
      </ul>
      <div class="call">
        <div class="call-label">Prefer to call?</div>
        <a href={NAP.phoneTel} class="call-number"><span class="call-dot" aria-hidden="true"></span>{NAP.phoneDisplay}</a>
        <div class="call-sub">Free on-site assessment · no obligation</div>
      </div>
    </div>

    <div class="contact-card">
      <LeadForm
        intent={QUOTE_FORM.intent}
        fields={QUOTE_FORM.fields}
        consent={QUOTE_FORM.consent}
        smsConsent={QUOTE_FORM.smsConsent}
        submitLabel={QUOTE_FORM.submitLabel}
        successBody={QUOTE_FORM.successBody}
        anchorId="lead-form"
      />
    </div>
  </div>
</section>

<style>
  .contact { background: var(--slab); }
  .contact-grid {
    max-width: var(--container); margin: 0 auto;
    padding: clamp(44px, 6vw, 80px) var(--container-pad);
    display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-copy { color: var(--on-slab); }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--accent); margin-bottom: 18px; }
  .contact-copy h2 { font-family: var(--font-display); font-weight: 900; font-size: clamp(28px, 4vw, 46px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 18px; max-width: 16ch; color: var(--on-slab); }
  .lede { font-size: var(--fs-lede); color: var(--on-slab-muted); line-height: 1.6; margin: 0 0 28px; max-width: 46ch; }
  .checks { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .checks li { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; color: var(--on-slab-body); line-height: 1.45; }
  .checks .tick { color: var(--accent); font-weight: 800; font-size: 15px; }
  .call { border-top: 1px solid var(--slab-rule); padding-top: 22px; }
  .call-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--on-slab-faint); margin-bottom: 10px; }
  .call-number { font-family: var(--font-display); font-weight: 800; font-size: clamp(22px, 2.4vw, 30px); color: var(--on-slab); display: inline-flex; align-items: center; gap: 12px; }
  .call-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--signal); }
  .call-sub { font-family: var(--font-mono); font-size: 12px; color: var(--on-slab-dimmer); margin-top: 8px; }

  /* The form card is the engine <LeadForm>, which brings its own scoped styles. */
  .contact-card { min-width: 0; }
</style>
