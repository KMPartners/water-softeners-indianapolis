---
/**
 * "Where we work" — the service-area section with per-city NAMED utilities
 * (Core30 rule 4 local specificity, and local-SEO equity). Shared across the
 * homepage, category, and service templates. Carries id="areas" so the mobile
 * drawer's "Service Areas" link (/#areas) lands here on the homepage. Data from
 * src/content/nav.js; tokens only.
 */
import { CITY_UTILITIES } from '../content/nav.js';
---
<section id="areas" class="areas">
  <div class="areas-inner">
    <div class="areas-head"><h2>Where we work</h2><div class="rule" aria-hidden="true"></div></div>
    <p class="areas-p">We're based in <strong>Fishers</strong> and cover the surrounding Hamilton and Madison County area, <strong>Noblesville</strong>, <strong>Carmel</strong>, <strong>Westfield</strong>, and out to <strong>Pendleton</strong> and <strong>Anderson</strong>. When storms take the power out it is usually a <strong>Duke Energy</strong> or <strong>AES Indiana</strong> outage; in Anderson it is <strong>Anderson Municipal Light &amp; Power</strong>.</p>
    <div class="city-grid">
      {CITY_UTILITIES.map((c) => (
        <div class="city-card">
          <div class="city-name">{c.city}</div>
          <div class="city-util">{c.util}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .areas { background: var(--bg2); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .areas-inner { max-width: var(--container); margin: 0 auto; padding: clamp(40px,6vw,64px) var(--container-pad); }
  .areas-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 24px; }
  .areas-head h2 { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h3); letter-spacing: -.01em; margin: 0; color: var(--text-strong); }
  .areas-head .rule { flex: 1; height: 1px; background: var(--rule); }
  .areas-p { font-size: 15.5px; color: var(--text-body); line-height: 1.6; max-width: 66ch; margin: 0 0 22px; }
  .areas-p strong { color: var(--ink); }
  .city-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px,100%),1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .city-card { background: var(--surface-card); padding: 18px 20px; }
  .city-name { font-family: var(--font-display); font-weight: 800; font-size: 17px; letter-spacing: -.01em; color: var(--ink); }
  .city-util { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .04em; color: var(--text-muted); margin-top: 6px; }
</style>
