---
/**
 * Homepage — the one legitimately BESPOKE page (charter note).
 *
 * Category and service pages are row-driven (src/content/example.js → [slug].astro);
 * the homepage is hand-authored, pulling config + the preset schema. That is
 * correct and intended — do not try to force the homepage into the content tree.
 *
 * Everything here is NEUTRAL placeholder copy for the "Example Home Services"
 * demo. Replace it with the real business's homepage.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { NAP, AREA_SERVED, CTA_STATUS } from '../lib/site.js';
import { homepageSchema } from '../../presets/example/schema.js';
import { CATEGORIES, PAGES } from '../content/example.js';
import { QUOTE_FORM } from '../../presets/example/lead-forms.js';
import TrinityH1 from '../components/TrinityH1.astro';
import { trinityTitle } from '../lib/trinity.js';

// Core30 rule 1 (Trinity): the <title> and the <h1> are generated from ONE source
// (service + city) via trinityTitle / <TrinityH1>, so they cannot drift.
const HERO = { service: 'Handyman & Home Repair', city: 'Anytown, CA' };
const TITLE = trinityTitle(HERO);

const schemas = [homepageSchema(CATEGORIES)];

// Link every content page from the homepage (mirror-linking + a real internal
// link graph). The hub first, then its services.
const links = PAGES.map((p) => ({ href: `/${p.slug}/`, label: p.trinity }));
---

<BaseLayout title={TITLE} description={`Placeholder homepage for ${NAP.name}. Replace this copy before launch.`} canonical="/" schemas={schemas}>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <span class="eyebrow">Example Content · Replace Before Launch</span>
        <TrinityH1 service={HERO.service} city={HERO.city} size="hero" />
        <p class="lede">
          <strong>Placeholder hero for {NAP.addressLocality}, {NAP.addressRegion}.</strong>
          This is a neutral starter homepage — swap every word for real copy. {CTA_STATUS}.
        </p>
        <div class="home-hero-cta">
          <a href={NAP.phoneTel} class="click-to-call">
            <Icon name="phone" size={16} /> {NAP.phoneDisplay}
          </a>
          <a href="#lead-form" class="btn-primary">Get a free quote <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>

      <div class="home-hero-form">
        <LeadForm {...QUOTE_FORM} anchorId="lead-form" />
      </div>
    </div>
  </section>

  <section class="home-services">
    <div class="container">
      <h2>What we do</h2>
      <p class="section-sub">Placeholder service list. These link to the example content tree.</p>
      <ul class="service-grid">
        {links.map((l) => (
          <li><a href={l.href}>{l.label} <Icon name="arrow-right" size={15} /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-areas" id="service-area">
    <div class="container">
      <h2>Service area</h2>
      <p class="section-sub">Placeholder — {NAP.name} serves {NAP.addressLocality} and nearby.</p>
      <ul class="area-pills">
        {AREA_SERVED.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding: clamp(32px, 6vw, 64px) 0; border-bottom: 1px solid var(--border); }
  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(min(440px, 100%), 1fr) minmax(min(360px, 100%), 0.85fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  @media (max-width: 900px) { .home-hero-grid { grid-template-columns: 1fr; } }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: 12px;
  }
  /* the hero <h1> is <TrinityH1 size="hero" /> — self-styled (tokens only). */
  .lede { font-size: var(--fs-lede); line-height: var(--lh-body); color: var(--text-body); margin: 0 0 24px; max-width: 46ch; }
  .lede strong { color: var(--ink); }
  .home-hero-cta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .click-to-call {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-display); font-weight: 700; font-size: 16px;
    color: var(--text-strong); text-decoration: none; min-height: 44px;
  }
  .click-to-call:hover { color: var(--accent-deep); }

  .home-services, .home-areas { padding: clamp(32px, 5vw, 56px) 0; }
  .home-areas { background: var(--surface-alt); border-top: 1px solid var(--border); }
  .home-services h2, .home-areas h2 {
    font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2);
    letter-spacing: var(--ls-tight); color: var(--text-strong); margin: 0 0 8px;
  }
  .section-sub { color: var(--text-muted); margin: 0 0 24px; }

  .service-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); }
  .service-grid a {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 16px 18px; border: 1px solid var(--border-strong); border-radius: var(--radius);
    background: var(--surface-card); color: var(--text-strong); text-decoration: none;
    font-family: var(--font-display); font-weight: 700;
  }
  .service-grid a:hover { border-color: var(--accent); color: var(--accent-deep); }

  .area-pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .area-pills li {
    font-family: var(--font-mono); font-size: 13px; color: var(--text-body);
    background: var(--surface-card); border: 1px solid var(--border-strong);
    border-radius: 999px; padding: 7px 14px;
  }
</style>
