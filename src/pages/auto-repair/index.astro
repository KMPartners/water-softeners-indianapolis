---
/**
 * Auto Repair hub. Trinity: "Auto Repair Anderson, IN".
 *
 * This is the SECONDARY entity — the repair shop has its own GBP listing,
 * separate from the dealership (CLAUDE.md "Two entities, separated"). So the
 * page IS the AutoRepair node (autoRepairHubSchema), not a Service.
 *
 * Mirror linking DOWN (Core30 rule 3): the child grid links to all 7 repair
 * service entities. Those children link back UP via breadcrumb + footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import { REPAIR_SERVICES } from '../../lib/nav.js';
import { NAP, NEARBY_TOWNS_PROSE } from '../../lib/site.js';
import { breadcrumbSchema, faqSchema } from '../../lib/schema.js';
import { autoRepairHubSchema } from '../../../presets/auto/schema.js';

const TRINITY = 'Auto Repair Anderson, IN';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Auto Repair' },
];

const childBlurbs = {
  'brake-repair': 'Pads, rotors, calipers, and lines — with a road test before you leave.',
  'engine-diagnostics': 'OBD-II scan, root-cause testing, and a plain-language explanation.',
  'repair-maintenance': 'General repairs and scheduled maintenance to keep you on the road.',
  'oil-change': 'OEM-spec oil and filter with a multi-point check, quick turnaround.',
  'transmission-replacement': 'Diagnosis, rebuild or replacement, and fluid to OEM spec.',
  'audi-ecm-programming': 'Module flashing and coding through manufacturer-grade tooling.',
  'vw-ecm-programming': 'Volkswagen control-module programming and adaptation.',
};

const steps = [
  { title: 'Drop off or call', body: 'Tell us the symptoms. We schedule around your day.' },
  { title: 'Diagnose', body: 'OBD-II scan and hands-on testing to find the real cause.' },
  { title: 'Quote first', body: 'You approve the price before we touch the car.' },
  { title: 'Fix & road test', body: 'We repair it and verify the fix before you pick up.' },
];

const faqs = [
  {
    q: "Do you work on cars I didn't buy from you?",
    a: 'Absolutely. The repair shop is open to everyone, whether or not you bought your vehicle from Beach Family. You get the same honest diagnosis and fair pricing either way.',
  },
  {
    q: 'Will you tell me the cost before starting?',
    a: 'Always. We diagnose the problem, then quote you the repair and get your approval before any work begins. No surprise charges.',
  },
  {
    q: 'Can you really program Audi and VW modules?',
    a: "Yes — we offer Audi and VW ECM programming using manufacturer-grade tooling, a capability many independent shops don't have. See the Audi and VW ECM pages for detail.",
  },
  {
    q: 'How soon can I get in?',
    // VERIFY:turnaround truth-doc
    a: `Often same week, and frequently faster for existing customers. Call ${NAP.phoneDisplay} and we'll find you a time.`,
  },
];

const description =
  'Full-service auto repair in Anderson, IN — brakes, diagnostics, oil, transmissions, and ECM programming from a family shop that also sells cars.';
---

<BaseLayout
  title={TRINITY}
  description={description}
  canonical="/auto-repair/"
  schemas={[autoRepairHubSchema(), breadcrumbSchema(crumbs), faqSchema(faqs)]}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="page-hero">
    <div class="plate"></div>
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow on-dark">Secondary Category · Full-Service Shop</span>
        <h1>Auto Repair <span class="accent">Anderson, IN</span></h1>
        <p class="lede">
          <strong>Get your car fixed right the first time at a family shop in
          Anderson that services what it sells.</strong> From brakes to
          transmissions, our technicians diagnose the real problem and tell you
          before they touch it.
        </p>
        <div class="page-hero-cta">
          <a href={NAP.phoneTel} class="click-to-call">
            <Icon name="phone" size={16} />
            {NAP.phoneDisplay}
          </a>
          <a href="#services" class="btn-primary">
            See repair services
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <div class="page-hero-card">
        <div class="ph-title">Shop at a glance</div>
        <div class="ph-row"><span class="k">Services</span><span class="v num">7</span></div>
        <div class="ph-row"><span class="k">Diagnostics</span><span class="v">OBD-II</span></div>
        <div class="ph-row"><span class="k">Specialties</span><span class="v">Audi / VW ECM</span></div>
        <div class="ph-row"><span class="k">Location</span><span class="v">Anderson, IN 46016</span></div>
      </div>
    </div>
  </section>

  <section class="content-block">
    <div class="container">
      <div class="content-grid">
        <div class="side-label"><div class="n">01</div><div class="t">Why Beach Family</div></div>
        <div class="block-body">
          <h2>A repair shop first — and it shows</h2>
          <p>
            Beach Family Automotive began as a repair shop, and that's still the
            heart of the business. Because we put every car we sell across our own
            lifts, our technicians know these vehicles inside and out. Whether you
            bought from us or not, you get the same honest diagnosis and the same
            fair price.
          </p>
          <p>
            We work on domestic and import vehicles alike, and we hold specialty
            capability most corner lots don't — including Audi and VW ECM
            programming through manufacturer-grade tooling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Child grid — mirror linking DOWN to all 7 service entities -->
  <section class="content-block alt" id="services">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">Repair services</span>
        <h2>Everything we fix</h2>
        <p>
          Each service has its own page with specs, process, and local detail.
          Every job is quoted before we begin.
        </p>
      </div>
      <div class="card-grid">
        {REPAIR_SERVICES.map((s, i) => (
          <a class="svc-card" href={s.href}>
            <div class="ic"><Icon name="wrench" /></div>
            <div class="svc-n">SVC · 0{i + 1} / 07</div>
            <h3>{s.label}</h3>
            <p>{childBlurbs[s.slug]}</p>
            <span class="more">Learn more <Icon name="arrow-right" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-block">
    <div class="container">
      <div class="content-grid">
        <div class="side-label"><div class="n">03</div><div class="t">Process</div></div>
        <div class="block-body" style="width:100%">
          <h2>How a repair goes</h2>
          <div class="steps">
            {steps.map((s, i) => (
              <div class="step">
                <div class="step-num">0{i + 1}</div>
                <div class="step-title">{s.title}</div>
                <div class="step-body">{s.body}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-block alt">
    <div class="container">
      <div class="content-grid">
        <div class="side-label"><div class="n">04</div><div class="t">Local Notes</div></div>
        <div class="block-body">
          <h2>Serving Anderson &amp; Madison County</h2>
          <p>
            Our shop sits at {NAP.streetAddress} in Anderson, IN 46016,
            convenient to downtown and the I-69 corridor. We regularly service
            drivers from {NEARBY_TOWNS_PROSE}. Indiana requires most passenger
            vehicles to stay current on
            registration through the Indiana BMV — we can flag anything that
            would fail a safety check while we have your car.<!-- VERIFY:in-safety-inspection truth-doc -->
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-block">
    <div class="container">
      <div class="content-grid">
        <div class="side-label"><div class="n">05</div><div class="t">FAQ</div></div>
        <div class="block-body" style="width:100%">
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item" open>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-block alt">
    <div class="container">
      <div class="content-grid">
        <div class="side-label"><div class="n">06</div><div class="t">External</div></div>
        <div class="block-body">
          <h2>Backed by real standards</h2>
          <p>
            Automotive repair is a trade with real credentials. The National
            Institute for Automotive Service Excellence (ASE) sets the benchmark
            for technician competence, and we work to that standard.
          </p>
          <p>
            {/* Core30 rule 6 — this page's single external authority link. */}
            <a class="backlink" href="https://www.ase.com/" target="_blank" rel="noopener">
              ASE — Automotive Service Excellence ↗
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <FinalCta
    heading="Something not right with your car?"
    body="Bring it to a shop that tells you the truth. Call Beach Family Automotive in Anderson."
  />
</BaseLayout>
