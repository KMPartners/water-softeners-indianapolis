---
/**
 * Terms of Service. Trinity: "Terms of Service". ENGINE route.
 *
 * The ToS section list is the part that genuinely varies per vertical (task
 * §1.2), so the document comes from the ACTIVE preset — here the generator
 * preset (installs, service scope, warranties, permits/utility realities). The
 * spine, schema, breadcrumb, and layout are all Engine and do not change.
 *
 * INDEXABLE and in the sitemap (task §2.6). Content: presets/generator/legal.js;
 * the spine is components/LegalDoc.astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { TERMS_OF_SERVICE as doc } from '../../presets/generator/legal.js';
import { legalPageSchema, breadcrumbSchema } from '../lib/schema.js';

const crumbs = [{ label: 'Home', href: '/' }, { label: doc.trinity }];
---

<BaseLayout
  title={doc.trinity}
  description={doc.description}
  canonical={doc.slug}
  pageLabel="Terms of Service"
  schemas={[
    legalPageSchema({ name: doc.trinity, description: doc.description, url: doc.slug }),
    breadcrumbSchema(crumbs),
  ]}
>
  <Breadcrumbs crumbs={crumbs} />
  <LegalDoc doc={doc} />
</BaseLayout>
