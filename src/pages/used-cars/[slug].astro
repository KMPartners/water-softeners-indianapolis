---
/**
 * Vehicle detail TEMPLATE — one static page per Available/Pending vehicle,
 * generated at build time from Airtable (correction #1).
 *
 * Layout ported from the React kit's VehicleDetail
 * (_design-reference/ui_kits_website_react/inventory.jsx:58): gallery + thumbs,
 * seller notes, spec grid, transparency block, sticky buy rail, similar rail.
 *
 * Schema: Car + nested Offer, seller -> AutoDealer (correction #2).
 * NEVER aggregateRating here.
 *
 * Trinity: <title>, <h1>, and the URL slug all carry the same phrase —
 * "<Year Make Model> for Sale in Anderson, IN". See the note at `heading`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import TransparencyBlock from '../../components/TransparencyBlock.astro';
import { ROUTES } from '../../lib/nav.js';
import { NAP } from '../../lib/site.js';
import { vehicleSchema, breadcrumbSchema } from '../../lib/schema.js';
import {
  getListableVehicles,
  getSimilarVehicles,
  formatPrice,
  formatMiles,
} from '../../lib/inventory.js';

export async function getStaticPaths() {
  // Available + Pending only. Sold vehicles keep no page (spec §3.3 routes
  // those to "this one's sold — see similar" from the grid instead).
  const vehicles = await getListableVehicles();
  return vehicles.map((vehicle) => ({
    params: { slug: vehicle.slug },
    props: { vehicle },
  }));
}

const { vehicle: v } = Astro.props;
const similar = await getSimilarVehicles(v);

// Core30 rule 1 — Trinity. `heading` is the exact string used as the <title>,
// as the <h1> text, and (slugified) as the URL. The <h1> renders the trailing
// locality in an accent span, matching the reference's styling pattern on
// brake-repair.html — same text, two colours, so the match stays byte-exact.
const vehicleName = [v.year, v.make, v.model].filter(Boolean).join(' ');
const localSuffix = 'for Sale in Anderson, IN';
const heading = `${vehicleName} ${localSuffix}`;
const canonical = `/used-cars/${v.slug}/`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Used Cars', href: ROUTES.usedCars.href },
  { label: vehicleName },
];

// Core30 rule 5 — technical/spec injection. Only rows with real values render;
// we never pad the table with "N/A" to make it look complete.
const specs = [
  ['Mileage', formatMiles(v.mileage)],
  ['Drivetrain', v.drivetrain],
  ['Engine', v.engine],
  ['Transmission', v.transmission],
  ['Body', v.body],
  ['MPG', v.mpg],
  ['Exterior', v.extColor],
  ['Interior', v.intColor],
  ['Year', v.year],
].filter(([, value]) => value != null && value !== '');

const description = v.description
  ? v.description.slice(0, 155)
  : `${vehicleName} for sale in Anderson, IN at Beach Family Automotive. Shop-inspected, with in-house financing for all credit types.`;

// Mobile bottom bar, vehicle-page variant (spec §5): "Text about this VIN"
// (sms: deep link, VIN pre-filled — one-tap async lead) + Get Pre-Qualified.
// Status dot reflects Available (green) vs Pending (amber).
const smsBody = `Hi — I'm interested in the ${vehicleName}${v.vin ? `, VIN ending ${v.vin.slice(-8).toUpperCase()}` : ''}.`;
const vehicleMobileCta = {
  status: `${v.status} · ${vehicleName}`,
  statusTone: v.status === 'Pending' ? 'pending' : 'go',
  primary: v.vin
    ? { label: 'Text about this VIN', href: `${NAP.phoneSms}?&body=${encodeURIComponent(smsBody)}`, icon: 'phone' }
    : { label: 'Get Pre-Qualified', href: ROUTES.bhph.href, icon: 'arrow-right' },
  secondary: { label: 'Pre-Qualify', href: ROUTES.bhph.href },
};
---

<BaseLayout
  title={heading}
  description={description}
  canonical={canonical}
  mobileCta={vehicleMobileCta}
  schemas={[vehicleSchema(v), breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="content-block" style="padding-top:20px">
    <div class="container vehicle-grid">
      <div>
        <!-- Gallery -->
        <div class="vehicle-hero">
          {v.heroPhoto ? (
            <img src={v.heroPhoto} alt={`${vehicleName} for sale in Anderson, IN`} />
          ) : (
            <>
              <svg class="inv-watermark" viewBox="0 0 24 24"><use href="#i-car" /></svg>
              <span class="inv-drop">Real vehicle photo</span>
            </>
          )}
          <span class={`inv-status ${(v.status || '').toLowerCase()}`}>{v.status}</span>
        </div>

        {v.photos.length > 1 && (
          <div class="vehicle-thumbs">
            {v.photos.slice(1, 5).map((p, i) => (
              <img src={p.url} alt={`${vehicleName} photo ${i + 2}`} loading="lazy" />
            ))}
          </div>
        )}

        <!-- Seller notes, in the owner's own voice -->
        {v.description && (
          <div class="vehicle-section">
            <span class="eyebrow">Straight from the shop</span>
            <h2>About this {v.make}</h2>
            <p>{v.description}</p>
          </div>
        )}

        {v.features.length > 0 && (
          <div class="vehicle-section">
            <span class="eyebrow">Included</span>
            <h2>Features</h2>
            <ul class="feature-chips">
              {v.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        )}

        <!-- Spec injection -->
        {specs.length > 0 && (
          <div class="vehicle-section">
            <span class="eyebrow">The details</span>
            <h2>Specifications</h2>
            <div class="spec-table">
              {specs.map(([k, value]) => (
                <div class="row">
                  <span class="k">{k}</span>
                  <span class="v num">{value}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Transparency / work-order block (carries the NHTSA authority link) -->
        <div class="vehicle-section">
          <span class="eyebrow">No surprises</span>
          <h2>What we know about this vehicle</h2>
          <TransparencyBlock
            vin={v.vin}
            titleStatus={v.titleStatus}
            owners={v.owners}
            accidents={v.accidents}
          />
        </div>
      </div>

      <!-- Sticky buy rail -->
      <div class="buy-rail">
        <div class="buy-card">
          <div class="buy-eyebrow">{[v.year, v.trim].filter(Boolean).join(' · ')}</div>
          {/* Core30 rule 1: H1 text is byte-identical to the <title> keyphrase. */}
          <h1>{vehicleName} <span class="accent h1-suffix">{localSuffix}</span></h1>

          <div class="buy-price-row">
            <div>
              <div class="inv-plabel">Sale price</div>
              <div class="buy-price num">{formatPrice(v.price)}</div>
            </div>
            {/* Rendered only from a real confirmed figure — never computed. */}
            {v.weekly != null && (
              <span class="inv-wk">
                <span class="amt num">${v.weekly}/wk</span>
                <span class="lbl">Est. · O.A.C.</span>
              </span>
            )}
          </div>

          <div class="buy-actions">
            <a class="btn-primary" href={ROUTES.bhph.href}>
              Get Pre-Qualified
              <Icon name="arrow-right" size={18} />
            </a>
            <a class="btn-ghost buy-call" href={NAP.phoneTel}>
              <Icon name="phone" size={16} />
              Call about this car
            </a>
            {v.vin && (
              <a
                class="btn-ghost buy-call"
                href={`${NAP.phoneSms}?&body=${encodeURIComponent(`Hi — I'm interested in the ${vehicleName}, VIN ending ${v.vin.slice(-8).toUpperCase()}.`)}`}
              >
                Text about this VIN
              </a>
            )}
          </div>

          {/*
            COMPLIANCE — verbatim from the React kit (inventory.jsx:130). Must
            stay attached to any payment figure shown above.
          */}
          <p class="buy-legal">
            Payment is an estimate for qualified buyers, subject to approval. We
            finance all credit types; approval is not guaranteed. Advertised
            price excludes tax, title, and registration.
          </p>
        </div>

        <div class="buy-assurance">
          <span><Icon name="shield-check" size={26} /></span>
          <div>
            <div class="ba-title">Shop-inspected &amp; serviced</div>
            <div class="ba-body">
              Inspected on our own lifts before listing. We service what we sell.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="content-block alt">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">You might also like</span>
          <h2>Similar vehicles</h2>
        </div>
        <div class="inv-grid">
          {similar.map((s) => <VehicleCard vehicle={s} />)}
        </div>
      </div>
    </section>
  )}

  <FinalCta
    heading="Want to see it in person?"
    body="Come by the lot on Dr. M.L.K. Jr Blvd, or call and we'll hold it for you."
  />
</BaseLayout>

<style>
  .vehicle-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 44px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .vehicle-grid {
      grid-template-columns: 1fr;
    }
    .buy-rail {
      position: static !important;
    }
  }

  .vehicle-hero {
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--navy-600) 0%, var(--navy-800) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
  }
  .vehicle-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vehicle-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }
  .vehicle-thumbs img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius-1);
  }

  .vehicle-section {
    margin-top: 34px;
  }
  .vehicle-section h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 3vw, 30px);
    letter-spacing: -0.02em;
    margin: 12px 0 16px;
    color: var(--navy-700);
  }
  .vehicle-section > p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 68ch;
    margin: 0;
  }

  .feature-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .feature-chips li {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-1);
    padding: 7px 11px;
  }

  .buy-rail {
    position: sticky;
    top: 84px;
    display: grid;
    gap: 14px;
  }

  .buy-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    padding: 22px;
    box-shadow: var(--shadow-md);
  }
  .buy-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .buy-card h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
    letter-spacing: -0.02em;
    margin: 3px 0 14px;
    color: var(--navy-700);
  }
  .buy-price-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .buy-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 34px;
    letter-spacing: -0.02em;
    color: var(--navy-700);
    line-height: 1;
  }

  .buy-actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .buy-actions .btn-primary {
    justify-content: center;
  }
  /* .btn-ghost is white-on-navy by default; this rail sits on paper. */
  .buy-call {
    justify-content: center;
    color: var(--navy-700);
    border-color: var(--border-strong);
  }
  .buy-call:hover {
    border-color: var(--amber-500);
  }

  .buy-legal {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    margin: 16px 0 0;
    line-height: 1.6;
  }

  .buy-assurance {
    background: var(--navy-700);
    color: #fff;
    border-radius: var(--radius-2);
    padding: 20px;
    display: flex;
    gap: 13px;
    align-items: flex-start;
  }
  .buy-assurance > span {
    color: var(--amber-400);
    flex-shrink: 0;
  }
  .ba-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 4px;
  }
  .ba-body {
    font-size: 13.5px;
    color: var(--text-on-slab);
    line-height: 1.5;
  }
</style>
