# ── Dependencies ───────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/

# ── Build output ───────────────────────────────
dist/
# Generated from site.config.json by scripts/gen-function-config.mjs (prebuild).
functions/api/_config.generated.js
build/
.output/
.astro/
.next/
out/
.vercel/
.netlify/
_site/            # Eleventy default

# ── Env / secrets ──────────────────────────────
.env
.env.*
!.env.example
.wrangler/        # wrangler local state/cache, created by CF Pages deploys

# ── Logs ───────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS / editor cruft ──────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ── Caches ─────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ── Python (scripts/optimize.py) ───────────────
__pycache__/
*.py[cod]
.venv/
venv/
