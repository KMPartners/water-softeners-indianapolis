# ─────────────────────────────────────────────────────────────────────────────
# VARIABLE-NAME CONTRACT. Copy to .env and fill in per client; never commit .env.
#
# The NAMES here are Engine and stay identical across every site built on this
# starter. Only the VALUES are per-client (charter §5; concrete CLAUDE.md rule 8:
# the secret *name* stays constant, the value is per-site env). Renaming a
# variable in a leaf site breaks the shared endpoint/script contract — don't.
#
# No real client value belongs in this file, ever. It ships empty on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical host, including protocol and subdomain (e.g. https://www.example.com).
# Must name the same host as `site:` in astro.config.mjs — canonical <link>s,
# JSON-LD `url`, and the sitemap read from these, so a mismatch splits canonical.
PUBLIC_SITE_URL=

# Primary phone in E.164 (e.g. +15555550123).
PUBLIC_PHONE=

# Cloudflare Pages project to deploy into. Read by `npm run deploy:*` via the
# cross-platform wrapper scripts/deploy.mjs, which reads this from the environment
# in Node — so it resolves the same in bash, Windows cmd/PowerShell, and CI.
CF_PAGES_PROJECT=

# ── Lead form destination ────────────────────────────────────────────────────
# The form posts to the same-origin Cloudflare Pages Function at
# /api/lead (functions/api/lead.js), which pushes the lead into
# the CRM. Setting FORM_ENDPOINT is only needed to silence the build-time
# LAUNCH BLOCKER warning — the form already defaults to /api/lead.
#
# Per-client lead routing (which inbox, which phone) is configured in the CRM
# workflow, NOT here. Never record a client's contact details in this file.
FORM_ENDPOINT=/api/lead

# ── GoHighLevel Inbound Webhook (Path A) ─────────────────────────────────────
# RUNTIME secret for the Pages Function — NOT a build var. In production it lives
# as a Cloudflare Pages secret; it is only in .env locally so `npm run ghl:test`
# can post a sample payload. Never inline it into client HTML, never set it as
# FORM_ENDPOINT, and never commit a real value.
#
# GHL_WEBHOOK_URL: the Inbound Webhook trigger URL from the GHL workflow
#   (Automation -> Workflows -> Trigger "Inbound Webhook" -> Save to reveal URL).
# If unset, the Pages Function runs in demo mode: accept + discard (no logging),
# so staging still shows its success state.
GHL_WEBHOOK_URL=

# Custom-field provisioning (`npm run ghl:provision`). Separate from the webhook
# URL above: this is the v2 API, used ONCE per site to create the custom fields
# the lead pipeline forwards (the SMS consent package + Lead Summary / Lead
# Summary HTML). Not needed at runtime. `npm run ghl:provision:dry` previews.
#
# GHL_API_KEY: a v2 Private Integration Token (pit-…) with scope
#   locations/customFields.write. GHL_LOCATION_ID: the sub-account location id.
GHL_API_KEY=
GHL_LOCATION_ID=

# Analytics (optional). PUBLIC_ = build-time, exposed to the client (fine — these
# ids are public). Set PUBLIC_GTM_ID as a host BUILD var to load Google Tag
# Manager; then manage GA4 + conversions in the GTM UI (no code changes).
PUBLIC_GTM_ID=
PUBLIC_GA_ID=
